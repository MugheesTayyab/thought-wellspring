# ==============================================================================
# BajiHears Environment Variables (.env.local)
# ==============================================================================

# 1. Supabase Project URL (Dashboard -> Project Settings -> API)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# 2. Supabase Anon Key (Dashboard -> Project Settings -> API)
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

# 3. Supabase Service Role Key (Dashboard -> Project Settings -> API -> Secret service_role)
# NEVER expose this on the client. Used strictly in Server Functions and Worker cron jobs.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# 4. Supabase Database Transaction Pooler URL (Port 6543)
# (Dashboard -> Project Settings -> Database -> Connection Pooling -> Transaction Mode, Port 6543)
SUPABASE_DATABASE_URL=postgresql://postgres.your-project-id:[YOUR-PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:6543/postgres
